{
  "dataset": {
    "image_dimension": 256,
    "channels": 3,
    "img_directory": "Specify autoencoder images folder"
  },
  "training": {
    "seed": 42,
    "epochs": 40,
    "batch_size": 128,
    "learning_rate": 0.001,
    "version": 1
  },
  "model": {
    "type": "vae",
    "latent_dim": 256,
    "filter_sizes": [32, 64, 128, 256, 256],
    "activation": "silu",
    "kernel_initializer": "he_uniform",
    "kernel_size": 3,
    "use_batch_norm": true,
    "l1_lambda": 2e-7,
    "noise_factor": 0.2,
    "beta": 0.01
  },
  "model_folder":"Specify save folder"
}